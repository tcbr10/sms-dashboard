// Copy to wrangler.jsonc in this folder (git-ignored) and replace every REPLACE_WITH value.
{
  "name": "sms-links",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-06",
  "workers_dev": false,
  "preview_urls": false,
  // The short-link hostname, in a zone of the same Cloudflare account. Keep it short: every tracked link starts with it.
  // Never put an Access application on it: recipients open these links. Set the same address (https://hostname) as
  // "כתובת הקישורים המקוצרים" in the admin page's settings.
  "routes": [{"pattern": "REPLACE_WITH_LINKS_HOSTNAME", "custom_domain": true}],
  "d1_databases": [{"binding": "DB", "database_name": "sms-dashboard", "database_id": "REPLACE_WITH_D1_DATABASE_ID", "migrations_dir": "../../migrations"}]
}
