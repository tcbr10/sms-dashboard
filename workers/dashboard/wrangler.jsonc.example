// Copy to wrangler.jsonc in this folder (git-ignored) and replace every REPLACE_WITH value.
{
  "name": "sms-dashboard",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-06",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {"ACCESS_ISSUER": "https://REPLACE_WITH_TEAM.cloudflareaccess.com", "ACCESS_AUD": "REPLACE_WITH_ACCESS_APPLICATION_AUD"},
  // A hostname in a zone of the same Cloudflare account, protected by a Cloudflare Access application.
  "routes": [{"pattern": "REPLACE_WITH_DASHBOARD_HOSTNAME", "custom_domain": true}],
  "d1_databases": [{"binding": "DB", "database_name": "sms-dashboard", "database_id": "REPLACE_WITH_D1_DATABASE_ID", "migrations_dir": "../../migrations"}]
}
